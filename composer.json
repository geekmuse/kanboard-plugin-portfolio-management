{
    "name": "geekmuse/kanboard-plugin-portfolio-mgmt",
    "description": "Kanboard plugin: cross-project portfolio management with milestones and dependency visualization",
    "type": "kanboard-plugin",
    "license": "MIT",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^3.9",
        "phpstan/phpstan": "^1.12"
    },
    "autoload": {
        "psr-4": {
            "Kanboard\\Plugin\\Portfolio\\": "./"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kanboard\\Plugin\\Portfolio\\Test\\": "./Test/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
